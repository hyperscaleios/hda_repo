app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False
db = SQLAlchemy(app)

import routes

class Customer(db.model):
    cust_id = db.Column(db.Integer, primary_key = True)
    cust_type = db.Column(db.Integer)
    cust_name = db.Column(db.String(120))
    cust_date = db.Column(db.Date)
    is_deleted = db.Column(db.Boolean)

    def __repr__(self):
        return f"Customer('{self.cust_name}', '{self.cust_type}')"

